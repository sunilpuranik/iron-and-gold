# Copy to .env and fill in from Supabase → Project Settings → API.
# Both values are public by design (they ship inside the app); row-level security protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Dev backend: copy this file to .env.dev and fill in a SECOND Supabase project, so dev builds never
# touch the beta testers' data. Without .env.dev, local and dev builds run offline (bots only).
