{
  "name": "iron-and-gold",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/im-fell-english": "^0.4.0",
    "@expo-google-fonts/libre-franklin": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.25",
    "expo-audio": "~57.0.5",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "lucide-react-native": "^1.48.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0"
  },
  "scripts": {
    "start": "expo start",
    "tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "simulate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/simulate.mjs",
    "sync:engine": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-engine.mjs",
    "deploy:functions": "npm run sync:engine && supabase functions deploy game",
    "db:push": "npx supabase db push",
    "publish:beta": "eas update --branch beta --message"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5"
  },
  "jest": {
    "preset": "jest-expo",
    "modulePathIgnorePatterns": [
      "<rootDir>/supabase/"
    ]
  }
}
